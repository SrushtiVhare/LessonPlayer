# Browser-safe Supabase settings. Leave these blank to run the bundled lesson only.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by npm run seed. Never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Used to write a fresh 10-question mission. Never prefix this with VITE_.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
